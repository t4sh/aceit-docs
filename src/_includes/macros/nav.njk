{% macro render(items, currentUrl) %}
<ul class="nav-list">
  {% for item in items %}
  <li>
    <a class="nav-link{% if item.url == currentUrl %} is-active{% endif %}" href="{{ item.url }}"{% if item.url == currentUrl %} aria-current="page"{% endif %}>{{ item.title }}</a>
    {% if item.children and item.children | length %}{{ render(item.children, currentUrl) }}{% endif %}
  </li>
  {% endfor %}
</ul>
{% endmacro %}
